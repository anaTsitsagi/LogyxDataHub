{
  // Local test environment only (DOTNET_ENVIRONMENT=Local). These values are NOT secrets.
  "ConnectionStrings": {
    "DataHub": "Server=(localdb)\\MSSQLLocalDB;Database=DataHub;Integrated Security=true;TrustServerCertificate=true"
  },
  "Database": {
    "CompatibilityLevel": 130
  },
  "S3": {
    "Bucket": "datahub-uploads",
    "ServiceUrl": "http://localhost:9000",
    "ForcePathStyle": true,
    "AccessKey": "minioadmin",
    "SecretKey": "minioadmin"
  },
  "RabbitMq": {
    "Uri": "amqp://guest:guest@localhost:5672/",
    "QueueType": "classic"
  },
  "Smtp": {
    "Host": "localhost",
    "Port": 1025,
    "Security": "None",
    "From": "datahub@localtest.me"
  },
  "Sms": {
    "Provider": "Outbox",
    "OutboxDirectory": "../../.local/sms-outbox"
  },
  "Processing": {
    "TempDirectory": "../../.local/worker-tmp"
  },
  "Otlp": {
    // Seq on this machine (logs and traces over OTLP/HTTP; UI at http://localhost:5341).
    "Endpoint": "http://localhost:5341/ingest/otlp",
    "ExportMetrics": false
  }
}