{
  // Non-secret defaults. Secrets and environment-specific values come from environment variables
  // (Kubernetes ConfigMap/Secret), e.g. ConnectionStrings__DataHub, S3__SecretKey, RabbitMq__Uri.
  "ConnectionStrings": {
    "DataHub": ""
  },
  "Database": {
    "CompatibilityLevel": 150
  },
  "S3": {
    "Bucket": "",
    "Region": "eu-central-1"
  },
  "RabbitMq": {
    "Uri": "",
    "QueueType": "quorum",
    "ClientName": "datahub-worker"
  },
  "Smtp": {
    "Host": "",
    "Port": 587,
    "Security": "StartTls",
    "From": ""
  },
  "Sms": {
    "Provider": "Outbox"
  },
  "Processing": {
    "TempDirectory": "/tmp/datahub-worker",
    "MaxAttempts": 3,
    "StaleAfter": "00:03:00",
    "RequeueAfter": "00:05:00"
  },
  "Otlp": {
    // OTLP/HTTP receiver base address; empty = console only. Otlp__Headers (e.g. an API key) comes from a Secret.
    "Endpoint": "",
    "ExportMetrics": true
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  }
}