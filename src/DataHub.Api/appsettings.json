{
  // Non-secret defaults. Secrets and environment-specific values come from environment variables
  // (Kubernetes ConfigMap/Secret), e.g. ConnectionStrings__DataHub, Security__SigningKey, S3__SecretKey.
  "ConnectionStrings": {
    "DataHub": ""
  },
  "Database": {
    "CompatibilityLevel": 150
  },
  "Auth": {
    "Authority": "",
    "Audience": "datahub-api",
    "InvitationsScope": "datahub.invitations",
    "ReportsScope": "datahub.reports"
  },
  "Security": {
    "SigningKey": ""
  },
  "Invitations": {
    "PortalBaseUrl": "",
    "LinkLifetime": "14.00:00:00"
  },
  "S3": {
    "Bucket": "",
    "Region": "eu-central-1"
  },
  "RabbitMq": {
    "Uri": "",
    "QueueType": "quorum",
    "ClientName": "datahub-api"
  },
  "Smtp": {
    "Host": "",
    "Port": 587,
    "Security": "StartTls",
    "From": ""
  },
  "Sms": {
    "Provider": "Outbox"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
