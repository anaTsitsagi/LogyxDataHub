<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@(ViewData["Title"] ?? "Staff portal") · DataHub</title>
    <style>
        :root {
            --bg: #f5f7fa; --card: #fff; --text: #1c2430; --muted: #5d6b7c; --line: #d9e0e8;
            --accent: #0f5ea8; --accent-dark: #0b4a85;
            --bad-bg: #fdecec; --bad: #a4262c; --ok-bg: #e8f5ec; --ok: #1d6b3a;
            --busy-bg: #e8f0fb; --busy: #0b4a85; --wait-bg: #f3f0e6; --wait: #6b5a1d;
            font-family: "Segoe UI", "Noto Sans Georgian", system-ui, sans-serif; font-size: 15px; line-height: 1.5;
            color: var(--text); background: var(--bg);
        }
        * { box-sizing: border-box; }
        body { margin: 0; background: var(--bg); }
        .wrap { max-width: 1080px; margin: 0 auto; padding-inline: 16px; }
        .top { background: var(--card); border-bottom: 1px solid var(--line); }
        .top .wrap { display: flex; align-items: center; justify-content: space-between; gap: 12px; min-height: 56px; flex-wrap: wrap; }
        .brand { font-weight: 700; color: var(--accent); text-decoration: none; font-size: 1.1rem; }
        .tag { font-size: .75rem; font-weight: 600; color: var(--wait); background: var(--wait-bg); border-radius: 99px; padding: 2px 10px; margin-left: 8px; }
        .top nav { display: flex; gap: 16px; font-size: .9rem; }
        main { padding-block: 24px; display: grid; gap: 20px; }
        .card { background: var(--card); border: 1px solid var(--line); border-radius: 10px; padding: 22px; min-width: 0; }
        h1 { font-size: 1.3rem; margin: 0 0 4px; } h2 { font-size: 1.1rem; margin: 0 0 12px; }
        .muted { color: var(--muted); font-size: .9rem; } p { margin: 0 0 8px; }
        a { color: var(--accent); }
        .grid { display: grid; gap: 12px 16px; grid-template-columns: repeat(2, minmax(0, 1fr)); }
        .field { display: grid; gap: 4px; } .field--wide { grid-column: 1 / -1; }
        label { font-weight: 600; font-size: .9rem; }
        input[type=text], input[type=email], input[type=tel], input[type=date], input:not([type]) {
            width: 100%; padding: 9px 11px; border: 1px solid var(--line); border-radius: 8px; font: inherit; background: #fff; color: var(--text);
        }
        .checks { display: flex; gap: 20px; flex-wrap: wrap; } .checks label { font-weight: 400; display: flex; gap: 6px; align-items: center; }
        .btn { display: inline-block; padding: 9px 18px; border: 0; border-radius: 8px; background: var(--accent); color: #fff; font: inherit;
               font-weight: 600; cursor: pointer; text-decoration: none; }
        .btn:hover { background: var(--accent-dark); }
        .btn--ghost { background: transparent; color: var(--accent); border: 1px solid var(--accent); }
        .btn--ghost:hover { background: var(--busy-bg); }
        .actions { display: flex; gap: 10px; flex-wrap: wrap; align-items: center; }
        .alert { border-radius: 8px; padding: 10px 14px; } .alert--bad { background: var(--bad-bg); color: var(--bad); }
        .alert--ok { background: var(--ok-bg); color: var(--ok); }
        .status { display: inline-block; border-radius: 99px; padding: 1px 10px; font-size: .82rem; font-weight: 600; white-space: nowrap; }
        .status--ok { background: var(--ok-bg); color: var(--ok); } .status--bad { background: var(--bad-bg); color: var(--bad); }
        .status--busy { background: var(--busy-bg); color: var(--busy); } .status--wait { background: var(--wait-bg); color: var(--wait); }
        .table-scroll { overflow-x: auto; }
        table { width: 100%; border-collapse: collapse; font-size: .9rem; }
        th, td { text-align: left; padding: 8px 10px; border-bottom: 1px solid var(--line); vertical-align: top; }
        th { color: var(--muted); font-weight: 600; font-size: .8rem; text-transform: uppercase; letter-spacing: .03em; }
        dl { display: grid; grid-template-columns: max-content minmax(0, 1fr); gap: 6px 16px; margin: 0; }
        dt { color: var(--muted); } dd { margin: 0; overflow-wrap: anywhere; }
        code, .mono { font-family: Consolas, "Cascadia Mono", monospace; font-size: .85rem; overflow-wrap: anywhere; }
        .reports { display: grid; gap: 12px; }
        .report { display: flex; gap: 10px; align-items: end; flex-wrap: wrap; }
        .report .field { min-width: 150px; }
        @@media (max-width: 640px) { .grid { grid-template-columns: 1fr; } dl { grid-template-columns: 1fr; } dd { margin-bottom: 6px; } }
    </style>
</head>
<body>
    <header class="top">
        <div class="wrap">
            <span><a class="brand" href="/staff">DataHub · Bank staff portal</a><span class="tag">LOCAL TEST TOOL</span></span>
            <nav>
                <a href="/staff">New invitation</a>
                <a href="/swagger">API (Swagger)</a>
            </nav>
        </div>
    </header>
    <main class="wrap">
        @RenderBody()
    </main>
</body>
</html>
