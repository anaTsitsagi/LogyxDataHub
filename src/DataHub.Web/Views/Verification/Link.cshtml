@model LinkViewModel
@{ ViewData["Title"] = "ვერიფიკაცია"; }
<section class="card">
    <p class="step">ნაბიჯი 1 / 3 <span class="en">Step 1 of 3</span></p>
    <h1>@Model.CompanyName</h1>
    <p>
        ORIS-ის მონაცემების ასატვირთად დაადასტურეთ კომპანიის მონაცემები. ვერიფიკაციის კოდს გამოგიგზავნით.
        <span class="en block">To upload your ORIS data, confirm your company details. We'll send you a verification code.</span>
    </p>

    @if (Model.Error is not null)
    {
        <div class="alert" role="alert">@Model.Error.Ka <span class="en block">@Model.Error.En</span></div>
    }

    <form method="post" asp-antiforgery="true" action="/i/@Model.Token" class="form">
        <label for="CompanyCode">კომპანიის საიდენტიფიკაციო კოდი <span class="en">Company ID</span></label>
        <input id="CompanyCode" name="CompanyCode" value="@Model.Form.CompanyCode" inputmode="numeric" autocomplete="off"
               pattern="\d{9}|\d{11}" required />

        @if (Model.RequiresEmail)
        {
            <label for="Email">ელ. ფოსტა <span class="en">Email</span></label>
            <input id="Email" name="Email" type="email" value="@Model.Form.Email" autocomplete="email" required />
        }

        <button type="submit" class="btn">კოდის მიღება <span class="en">Send code</span></button>
    </form>
</section>
