@model CodeViewModel
@{ ViewData["Title"] = "კოდი"; }
<section class="card">
    <p class="step">ნაბიჯი 2 / 3 <span class="en">Step 2 of 3</span></p>
    <h1>შეიყვანეთ კოდი <span class="en">Enter the code</span></h1>
    @if (!string.IsNullOrEmpty(Model.Destination))
    {
        <p>კოდი გაიგზავნა: <strong>@Model.Destination</strong> <span class="en block">We sent a code to @Model.Destination</span></p>
    }

    @if (Model.Error is not null)
    {
        <div class="alert" role="alert">@Model.Error.Ka <span class="en block">@Model.Error.En</span></div>
    }

    <form method="post" asp-antiforgery="true" action="/verify/@Model.ChallengeId" class="form">
        <input type="hidden" name="token" value="@Model.Token" />
        <label for="code">ვერიფიკაციის კოდი <span class="en">Verification code</span></label>
        <input id="code" name="code" class="code" inputmode="numeric" autocomplete="one-time-code" maxlength="6"
               pattern="\d{6}" required autofocus />
        <button type="submit" class="btn">დადასტურება <span class="en">Confirm</span></button>
    </form>
    <p class="muted"><a href="/i/@Model.Token">ახალი კოდის მოთხოვნა <span class="en">Request a new code</span></a></p>
</section>
